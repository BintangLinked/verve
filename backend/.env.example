# Copy to backend/.env and fill in the password. DO NOT commit the .env file.
# Application database and a dedicated test database (its contents are emptied after every test).
DATABASE_URL=postgresql+psycopg://verve:PASSWORD@localhost:5432/database_verve
TEST_DATABASE_URL=postgresql+psycopg://verve:PASSWORD@localhost:5432/database_verve_test

# Odoo integration: "mock" = built-in sample data; "live" = only the Odoo connected through the Odoo configuration menu.
# The Odoo URL, database name and API key are NOT written here: enter them through the Odoo configuration menu (stored encrypted).
# Use ONE Odoo service account with minimum access rights.
ODOO_MODE=mock
# Private/loopback addresses are blocked (SSRF protection) unless permitted. Set to true if Odoo runs on localhost/an internal network.
# Link-local and cloud metadata addresses (169.254.x.x) are ALWAYS blocked.
# ODOO_ALLOW_PRIVATE_HOSTS=true

# Admin login for the Odoo connection endpoint. Generate the values with: python -m app.hash_password
# (prints ADMIN_PASSWORD_HASH and SESSION_SECRET; add ADMIN_USERNAME yourself).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH='scrypt$...'
# SESSION_SECRET='at-least-32-random-characters'
# SESSION_TTL_MINUTES=60
# COOKIE_SECURE=true        # set to true if the API is served over HTTPS

# Encryption key for the Odoo API key stored through the Odoo Configuration menu (required to store the API key in the application).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not change it after an API key has been stored: the old key can no longer be read and must be re-entered.
# SETTINGS_ENCRYPTION_KEY=

# Permitted frontend origins (comma-separated).
CORS_ORIGINS=http://localhost:3000
